# NuForce workspace toolchain. Loaded by direnv in this folder and every repo under it.
# Nothing here is global: leave the folder and PATH and AWS_PROFILE go back to normal.

# PHP 8.3, matching production (serversideup/php:8.3-fpm-nginx). Homebrew keg, not linked.
PATH_add /opt/homebrew/opt/php@8.3/sbin
PATH_add /opt/homebrew/opt/php@8.3/bin

# Project-local Composer and AWS CLI v2 (.tools/, gitignored).
PATH_add .tools/bin

# Flutter
PATH_add "$HOME/flutter/bin"

# AWS: always the nuforce profile in this workspace.
export AWS_PROFILE=nuforce
export AWS_SDK_LOAD_CONFIG=1

# Per-machine overrides that should not be committed.
source_env_if_exists .envrc.local
